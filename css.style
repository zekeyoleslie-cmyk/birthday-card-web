/* Birthday Card - complementary stylesheet
   Load AFTER the inline <style> block so these rules enhance it. */

:root {
    --pink: #ff6fa3;
    --pink-soft: #ffb6c1;
    --purple: #c084fc;
    --ink: #4a2f3a;
    --glass: rgba(255, 255, 255, 0.85);
}

/* ---------- Card entrance ---------- */
.card {
    position: relative;
    z-index: 2;
    max-width: calc(100vw - 32px);
    box-sizing: border-box;
    animation: cardIn 0.9s cubic-bezier(0.22, 1, 0.36, 1) both,
               cardFloat 6s ease-in-out 1s infinite;
}

.card::before {
    content: "";
    position: absolute;
    inset: -3px;
    z-index: -1;
    border-radius: 23px;
    background: linear-gradient(45deg, var(--pink), var(--purple), #ffd6a5, var(--pink));
    background-size: 300% 300%;
    animation: borderGlow 6s linear infinite;
    opacity: 0.55;
    filter: blur(6px);
}

@keyframes cardIn {
    from { opacity: 0; transform: translateY(30px) scale(0.9); }
    to   { opacity: 1; transform: translateY(0) scale(0.95); }
}

@keyframes cardFloat {
    0%, 100% { translate: 0 0; }
    50%      { translate: 0 -8px; }
}

@keyframes borderGlow {
    0%   { background-position: 0% 50%; }
    100% { background-position: 300% 50%; }
}

/* ---------- Typography polish ---------- */
.title { text-wrap: balance; }

.name {
    display: inline-block;
    animation: nameWiggle 3s ease-in-out infinite;
}

@keyframes nameWiggle {
    0%, 100% { transform: rotate(-2deg); }
    50%      { transform: rotate(2deg) scale(1.05); }
}

/* ---------- Button ---------- */
button:focus-visible,
.audio-toggle:focus-visible {
    outline: 3px solid var(--purple);
    outline-offset: 3px;
}

button:active { transform: scale(0.97); }

button:disabled {
    opacity: 0.7;
    cursor: default;
}

/* ---------- Floating hearts background ---------- */
.hearts-layer {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    overflow: hidden;
}

.heart {
    position: absolute;
    bottom: -40px;
    opacity: 0;
    animation: heartRise linear forwards;
    will-change: transform, opacity;
}

@keyframes heartRise {
    0%   { opacity: 0;    transform: translateY(0) translateX(0) scale(0.6); }
    15%  { opacity: 0.9; }
    100% { opacity: 0;    transform: translateY(-110vh) translateX(var(--drift, 30px)) scale(1.1); }
}

/* ---------- Confetti variants (override inline rules) ---------- */
.confetti {
    position: fixed;
    z-index: 5;
    pointer-events: none;
}

.confetti--circle { border-radius: 50%; }
.confetti--strip  { width: 6px; height: 14px; }
.confetti--heart  {
    width: auto;
    height: auto;
    background: none !important;
    font-size: 16px;
    line-height: 1;
}

/* ---------- Cursor sparkles ---------- */
.sparkle {
    position: fixed;
    z-index: 4;
    pointer-events: none;
    font-size: 14px;
    animation: sparkleFade 0.9s ease-out forwards;
}

@keyframes sparkleFade {
    from { opacity: 1; transform: translateY(0) scale(1); }
    to   { opacity: 0; transform: translateY(-24px) scale(0.4); }
}

/* ---------- Surprise message ---------- */
.surprise {
    margin-top: 16px;
    min-height: 1.6em;
    color: #d63384;
    font-size: 18px;
    font-weight: bold;
}

.surprise::after {
    content: "|";
    margin-left: 2px;
    animation: blink 0.8s steps(1) infinite;
}

.surprise.done::after { content: ""; }

@keyframes blink { 50% { opacity: 0; } }

/* ---------- Audio toggle ---------- */
.audio-toggle {
    position: fixed;
    top: 16px;
    right: 16px;
    z-index: 10;
    width: 44px;
    height: 44px;
    margin: 0;
    padding: 0;
    border-radius: 50%;
    font-size: 20px;
    display: none;
    align-items: center;
    justify-content: center;
}

.audio-toggle.visible { display: flex; }

/* ---------- Small screens ---------- */
@media (max-width: 380px) {
    .card { padding: 20px 16px; }
    .title { font-size: 24px; }
    .name  { font-size: 28px; }
}

/* ---------- Accessibility: reduced motion ---------- */
@media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
    }
    .hearts-layer { display: none; }
}
